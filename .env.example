# DataLens AI - Environment Variables Template

# 1. AI Provider Credentials
# OpenRouter API Key for free open-source models (e.g. Llama 3)
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Gemini API Key (as a fallback or direct connection option)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Server Configuration
PORT=3001
NODE_ENV=development

# 3. Security & CORS Configuration
# Set to your deployed Vercel domain in production (e.g. https://datalens-ai.vercel.app)
FRONTEND_URL=http://localhost:3000

# 4. Rate Limiting Configuration
# Request window duration in milliseconds (e.g. 60000 = 1 minute)
RATE_LIMIT_WINDOW_MS=60000
# Maximum requests per IP address within the window duration
RATE_LIMIT_MAX_REQUESTS=30

# 5. Google OAuth Credentials
# Create credentials in Google Cloud Console (https://console.cloud.google.com/)
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here
